<Window x:Class="VoiceDuck.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceDuck" Height="320" Width="380"
        Icon="pack://application:,,,/Assets/icon_VoiceDuck.png"
        Closing="Window_Closing">
    <StackPanel Margin="16">
        <TextBlock Text="VoiceDuck" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock FontWeight="SemiBold" Text="Status:"/>
        <TextBlock x:Name="StatusText" Text="Initializing..." Margin="8,0,0,4"/>

        <TextBlock FontWeight="SemiBold" Text="Active Triggers:" Margin="0,8,0,0"/>
        <TextBlock x:Name="TriggersText" Text="-" Margin="8,0,0,4"/>

        <TextBlock FontWeight="SemiBold" Text="Ducking Ratio:" Margin="0,8,0,0"/>
        <TextBlock x:Name="RatioText" Text="-" Margin="8,0,0,8"/>

        <Button x:Name="ManualDuckButton" Content="Force Duck" Click="ManualDuckButton_Click" Width="120" HorizontalAlignment="Left" Margin="0,0,0,6"/>
        <Button Content="Settings..." Click="SettingsButton_Click" Width="120" HorizontalAlignment="Left" Margin="0,0,0,6"/>
        <Button Content="View Log" Click="ViewLogButton_Click" Width="120" HorizontalAlignment="Left"/>
    </StackPanel>
</Window>
